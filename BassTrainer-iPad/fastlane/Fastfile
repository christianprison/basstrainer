default_platform(:ios)

PROJECT = "BassTrainer.xcodeproj"
SCHEME  = "BassTrainer"
APP_ID  = "de.prisons.basstrainer"

platform :ios do
  desc "Build the app and upload it to TestFlight"
  lane :beta do
    # Auf CI: temporären Keychain anlegen, in den match das Zertifikat importiert.
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY"),
      is_key_content_base64: true
    )

    # Distributions-Zertifikat + Provisioning-Profil aus dem match-Repo holen.
    match(
      type: "appstore",
      app_identifier: APP_ID,
      readonly: true,
      api_key: api_key
    )

    # Versionsnummern: Marketing-Version aus dem Git-Tag (v1.2.3 -> 1.2.3),
    # Build-Nummer aus der GitHub-Run-Nummer (monoton steigend, von TestFlight verlangt).
    marketing_version = ENV["MARKETING_VERSION"].to_s
    build_number = ENV["GITHUB_RUN_NUMBER"] || Time.now.strftime("%Y%m%d%H%M")
    profile = "match AppStore #{APP_ID}"

    xcargs = []
    xcargs << "MARKETING_VERSION=#{marketing_version}" unless marketing_version.empty?
    xcargs << "CURRENT_PROJECT_VERSION=#{build_number}"
    xcargs << "CODE_SIGN_STYLE=Manual"
    xcargs << "DEVELOPMENT_TEAM=#{ENV['APPLE_TEAM_ID']}"
    xcargs << "PROVISIONING_PROFILE_SPECIFIER='#{profile}'"
    xcargs << "CODE_SIGN_IDENTITY='Apple Distribution'"

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      xcargs: xcargs.join(" "),
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: ENV["APPLE_TEAM_ID"],
        provisioningProfiles: {
          APP_ID => profile
        }
      }
    )

    # "What to Test" / Release Notes aus der Umgebung (vom Workflow gesetzt).
    changelog = ENV["TF_CHANGELOG"].to_s
    changelog = nil if changelog.strip.empty?

    upload_to_testflight(
      api_key: api_key,
      # Zum Setzen der Testhinweise muss auf die Verarbeitung gewartet werden.
      skip_waiting_for_build_processing: changelog.nil?,
      changelog: changelog,
      distribute_external: false
    )
  end
end
